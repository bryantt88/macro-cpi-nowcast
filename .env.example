# Copy this file to `.env` and fill in real values. `.env` is gitignored — never commit it.

# Free FRED API key — required for Stage 2 (ingestion). Get one at:
#   https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

